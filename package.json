{
  "name": "ethosh-project",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter=web run dev",
    "build": "bun scripts/build.js",
    "test": "bun scripts/test-contracts.js",
    "start": "bun --filter=web run start",
    "lint": "bun --filter=web run lint",
    "test:e2e": "bun tests/e2e/runner.js"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "impeccable": "^4.8.0"
  }
}
